# TypeSafe API key (https://docs.typesafe.ai) — Jev routing / compose
TYPESAFE_API_KEY=

# Anthropic API key — Haiku invents json-render Specs for unknown files
ANTHROPIC_API_KEY=

# Optional: Vercel AI Gateway instead of TYPESAFE_API_KEY
# AI_GATEWAY_API_KEY=
# JEV_AI_GATEWAY_API_KEY=

# Upstash Redis — required on Vercel for shared rate limits across instances.
# Create via https://vercel.com/integrations/upstash or Upstash console.
# Locally optional: without these, rate limits use in-memory sliding windows.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
