{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/compose.js": {
      "maxDuration": 300
    },
    "api/invent-viewer.js": {
      "maxDuration": 300
    },
    "api/fetch-resource.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
