{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "functions": {
    "api/compose.js": {
      "maxDuration": 300
    },
    "api/invent-viewer.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|open/|formats/|guides/|robots\\.txt|sitemap\\.xml|seo\\.css|og\\.png|og\\.svg|favicon\\.svg|filelathe-logo\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
