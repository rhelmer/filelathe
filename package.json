{
  "name": "filelathe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '{**/node_modules/**,**/.vite-temp/**,**/.vite/**}' --env-file=.env src/dev-server.ts",
    "predev": "tsx scripts/generate-seo.ts",
    "seo:generate": "tsx scripts/generate-seo.ts",
    "build": "tsx scripts/generate-seo.ts && vite build && node scripts/bundle-api.mjs",
    "build:api": "node scripts/bundle-api.mjs",
    "preview": "vite preview",
    "list-candidates": "tsx src/list.ts",
    "file-smoke": "tsx --env-file=.env src/file-smoke.ts",
    "invent-smoke": "tsx src/invent-smoke.ts",
    "archive-smoke": "tsx src/archive-smoke.ts",
    "office-smoke": "tsx src/office-smoke.ts",
    "check-types": "tsc --noEmit",
    "verify": "pnpm check-types && pnpm invent-smoke && pnpm archive-smoke && pnpm office-smoke && pnpm build",
    "demo:capture": "node scripts/social-media/capture-filelathe-demo.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@json-render/shadcn": "0.21.0",
    "@typesafe-ai/sdk": "0.6.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "ai": "7.0.107",
    "cfb": "^1.2.2",
    "chiptune3": "0.8.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.564.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.4.1",
    "xlsx": "^0.18.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.25.9",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  }
}
